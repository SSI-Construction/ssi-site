<!-- Floating CTA: fixed bottom-right, fades in once the user scrolls past the hero -->
<div id="floating-cta"
     class="fixed bottom-6 right-6 translate-y-4 z-50 opacity-0 pointer-events-none transition-all duration-300 ease-out">
  <a href="https://app.ssiconstruction.ca" target="_blank" rel="noopener"
     class="inline-block bg-blue-600 text-white px-6 py-3 rounded-full shadow-lg hover:bg-blue-700 transition font-semibold whitespace-nowrap">Start Free 60 Day Trial</a>
</div>
<script>
  (function() {
    var cta = document.getElementById('floating-cta');
    var hero = document.getElementById('hero');
    if (!cta || !hero) { return; }

    function toggleCta() {
      var threshold = hero.offsetTop + hero.offsetHeight;
      if (window.scrollY > threshold) {
        cta.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
        cta.classList.add('opacity-100', 'translate-y-0');
      } else {
        cta.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
        cta.classList.remove('opacity-100', 'translate-y-0');
      }
    }

    window.addEventListener('scroll', toggleCta, { passive: true });
    window.addEventListener('resize', toggleCta);
    toggleCta();
  })();
</script>
