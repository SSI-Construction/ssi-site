<script>
  document.querySelectorAll('.video-row').forEach(function(row) {
    row.addEventListener('click', function() {
      var videoId = this.getAttribute('data-video');

      // Hide all video containers and pause their videos
      document.querySelectorAll('.video-container').forEach(function(container) {
        container.classList.remove('active');
        var video = container.querySelector('video');
        if (video) { video.pause(); }
      });

      // Show the selected video
      var target = document.getElementById(videoId);
      target.classList.add('active');
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  function closeVideo(videoId) {
    var container = document.getElementById(videoId);
    var video = container.querySelector('video');
    if (video) { video.pause(); }
    container.classList.remove('active');
  }
</script>
